[Unit]
Description=Set BAT0 charge thresholds (preserve battery health)
After=multi-user.target
ConditionPathExists=/sys/class/power_supply/BAT0/charge_control_end_threshold

[Service]
Type=oneshot
# start must be written before end on some kernels; keep start < end
ExecStart=/bin/bash -c 'echo 50 > /sys/class/power_supply/BAT0/charge_control_start_threshold && echo 80 > /sys/class/power_supply/BAT0/charge_control_end_threshold'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
